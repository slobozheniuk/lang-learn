# ==============================================================================
# LangLearn Environment Configuration
# ==============================================================================
# Copy this template to .env before starting the backend:
#   cp .env.example .env
# ==============================================================================

# --- Database Configuration ---
# Cross-platform SQLite connection string (default for local development):
# On macOS / Linux, relative paths are resolved from the repository working directory:
DATABASE_URL=sqlite:///./lang_learn.db
# Alternatively, specify an absolute SQLite path on macOS:
# DATABASE_URL=sqlite:////Users/username/projects/lang-learn/lang_learn.db
# For PostgreSQL (production or containerized setup):
# DATABASE_URL=postgresql://user:password@localhost:5432/lang_learn

# --- Application Security & Auth ---
# Secret key used for signing JWT authentication tokens (change in production!)
SECRET_KEY=development-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM Provider Configuration ---
# LangLearn uses an OpenAI-compatible interface for multimodal lesson generation,
# translations, and interactive quiz creation.
#
# Supported providers:
# 1) Nous Research Portal (Recommended with Gemini 3.7 Flash)
#    Get your API key at https://portal.nousresearch.com
# 2) OpenAI
#    Get your API key at https://platform.openai.com
# 3) Any OpenAI-compatible endpoint (e.g., LocalAI, vLLM, Ollama, OpenRouter)
#
# Set ANY ONE of the following API key environment variables:
NOUS_API_KEY=
LLM_API_KEY=
OPENAI_API_KEY=

# Base URL for OpenAI-compatible API calls:
# - Nous Portal (Default): https://inference-api.nousresearch.com/v1
# - OpenAI: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Local Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://inference-api.nousresearch.com/v1

# LLM Model identifier:
# - Default: google/gemini-3.7-flash
# - Alternatives: openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, etc.
LLM_MODEL=google/gemini-3.7-flash

# --- Logging Configuration ---
# Logs are automatically rotated and retained for local debugging and auditing.
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_BACKUP_DAYS=7
LOG_FILE_NAME=app.log

# --- Optional Frontend Proxy / Backend Port Setting ---
# Used by Vite dev server (frontend/vite.config.ts) to proxy /api requests.
# Set this if running the FastAPI backend on port 8080 instead of 8000:
# VITE_BACKEND_PORT=8080
# VITE_BACKEND_URL=http://127.0.0.1:8080
